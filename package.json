{
  "name": "eukhe-site",
  "private": true,
  "type": "module",
  "scripts": {
    "eukhe": "sh scripts/eukhe.sh",
    "build": "vp run eukhe && vp run bend && vp build",
    "laws": "vp run eukhe && python3 scripts/laws.py",
    "deploy": "vp run build && vp exec wrangler deploy",
    "bend": "bend=\"$(python3 .eukhe/.github/scripts/pinned_bend.py)\" && \"$bend\" vim/vim.bend -o src/vim.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^26.6.2",
    "preact-render-to-string": "^6.7.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "browserslist": [
    "baseline widely available"
  ]
}
